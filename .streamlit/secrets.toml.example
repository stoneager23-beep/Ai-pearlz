# Optional settings for the deployed app. Copy to .streamlit/secrets.toml (local) or paste into
# the app's "Secrets" box on Streamlit Community Cloud. Top-level values become environment
# variables, which src/config.py reads; anything left out uses the defaults in .env.example.
#
# Do NOT put an OpenAI API key here. The app never uses a key of its own: every visitor enters
# theirs on the first screen, and the app removes OPENAI_API_KEY from its environment.

# OPENAI_CHAT_MODEL = "gpt-4.1-mini"
# OPENAI_CHAT_MODELS = "gpt-4.1-mini,gpt-4.1,gpt-4o-mini,gpt-4o"
# RELEVANCE_THRESHOLD = "0.34"
# LOG_LEVEL = "INFO"
