# SupportPearlz configuration.
# Copy this file to `.env` and change what you need. Every variable is optional:
# the value shown here is the default `src/config.py` uses when it is absent.
# The Streamlit app never reads OPENAI_API_KEY. It always asks the person using it.

# --- Secret: command-line tools only ----------------------------------------
# OpenAI key for the CLI chat, the index build and the evaluation scripts. Leave empty to be asked (hidden input).
OPENAI_API_KEY=

# --- Models ------------------------------------------------------------------
# Provider of the chat and embedding models. Only "openai" is implemented.
LLM_PROVIDER=openai
# Chat model used when nobody picks one. Must be listed in OPENAI_CHAT_MODELS.
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Comma-separated chat models users may pick from. Each must be in the catalogue in src/config.py.
OPENAI_CHAT_MODELS=gpt-4.1-mini,gpt-4.1,gpt-4o-mini,gpt-4o
# Embedding model for both indexing and querying. Changing it requires a full index rebuild.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Sampling temperature for answers. 0 is the most repeatable; values above 0.3 are rejected.
LLM_TEMPERATURE=0
# Seconds before an OpenAI request is abandoned.
OPENAI_TIMEOUT_SECONDS=30
# Retries, with exponential backoff, after a timeout, rate limit or server error.
OPENAI_MAX_RETRIES=4
# Chunks sent per embedding request. Each finished batch is cached, so a crash loses at most one batch.
EMBEDDING_BATCH_SIZE=64

# --- Knowledge base and index -------------------------------------------------
# Folder of source documents. Relative paths are resolved from the project root.
KNOWLEDGE_BASE_DIR=data/knowledge_base
# Folder where the persisted vector index is written (git-ignored).
VECTOR_STORE_DIR=data/vector_store
# Name of the index inside VECTOR_STORE_DIR. Letters, digits, "-" and "_" only.
COLLECTION_NAME=pearlz_kb
# Cache of computed embeddings (git-ignored), so unchanged chunks are never paid for twice.
EMBEDDING_CACHE_PATH=data/embedding_cache/embeddings.sqlite3
# Folder where experiment and evaluation scripts write their result tables.
RESULTS_DIR=evaluation/results

# --- Chunking (chosen by the experiment in Task 03) ---------------------------
# Maximum characters per chunk. Sections shorter than this stay whole.
CHUNK_SIZE=1500
# Characters shared by neighbouring chunks of a long section (15%). Must be smaller than CHUNK_SIZE.
CHUNK_OVERLAP=225
# Start every chunk with "Document > section path" so it keeps its parent headings' context.
CHUNK_CONTEXT_HEADERS=true

# --- Retrieval (chosen by the experiments in Task 06) -------------------------
# Number of chunks retrieved per question.
RETRIEVAL_K=4
# Minimum cosine similarity of the best chunk; below it the pipeline refuses without calling the model.
RELEVANCE_THRESHOLD=0.30

# --- Logging -------------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Folder for the rotating log file (git-ignored). Logs also go to standard output.
LOG_DIR=logs
